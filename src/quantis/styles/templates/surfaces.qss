QFrame#PlayMenu {
    background-color: ${panel_bg};
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: ${radius_capsule};
}

QFrame#TrackListPanel {
    background-color: ${surface};
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: 22px;
}

QFrame#glassPanel {
    background: ${panel_bg};
    border: none;
    border-radius: ${radius};
}

QFrame#sideNavRail {
    background-color: ${panel_bg};
    border: 1px solid rgba(${ink_rgb}, 0.06);
    border-radius: ${radius};
}

#trackTitle[playing="true"] {
    color: ${accent_fallback};
}

QWidget#homePage,
QWidget#homeScrollContent,
QWidget#homeHero,
QWidget#homeHeroCluster,
QWidget#libraryPage {
    background: transparent;
}

QScrollArea#homeScroll {
    background: transparent;
    border: none;
}

QWidget#playlistShelf,
QWidget#quickPickShelf,
QWidget#playlistShelfHost,
QWidget#quickPickShelfHost {
    background: transparent;
}

QLabel#homeKicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.4px;
    color: rgba(${hl_rgb}, 0.88);
    background: transparent;
    padding: 0;
}

QLabel#homeGreeting {
    font-size: 42px;
    font-weight: 700;
    letter-spacing: -1.6px;
    color: ${title};
    padding: 0;
    background: transparent;
    font-family: ${font_display};
}

QLabel#homeGreetingSub {
    font-size: 14px;
    font-weight: 400;
    color: rgba(${mist_rgb}, 0.55);
    letter-spacing: 0.15px;
    padding: 0 0 8px 0;
    background: transparent;
}

QWidget#homeSection,
QWidget#homeSectionBody {
    background: transparent;
}

QLabel#homeSectionTitle {
    font-size: 22px;
    font-weight: 700;
    color: ${title};
    letter-spacing: -0.45px;
    background: transparent;
    font-family: ${font_display};
}

QLabel#homeSectionSubtitle {
    font-size: 12px;
    color: rgba(${mist_rgb}, 0.45);
    background: transparent;
    font-family: ${font_label};
}

QLabel#homeSectionBadge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: rgba(${mist_rgb}, 0.75);
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: 8px;
    min-width: 20px;
    padding: 2px 8px;
    max-height: 20px;
}

QLabel#homePillBadge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.25px;
    color: rgba(${mist_rgb}, 0.82);
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: 8px;
    padding: 2px 8px;
    max-height: 20px;
}

QLabel#homePillBadge[variant="wave"] {
    color: rgba(125, 211, 252, 0.95);
    background: rgba(${hl_rgb}, 0.07);
    border-color: rgba(${hl_rgb}, 0.2);
}

QLabel#homePillBadge[variant="continue"] {
    color: rgba(253, 186, 210, 0.95);
    background: rgba(255, 92, 122, 0.08);
    border-color: rgba(255, 92, 122, 0.22);
}

QLabel#homeEmptyHint {
    font-size: 13px;
    color: rgba(${mist_rgb}, 0.4);
    padding: 16px 4px;
    background: transparent;
}

QFrame#playlistCard {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#playlistCard[hovered="true"] QLabel#playlistCardTitle {
    color: rgb(${hl_rgb});
}

QLabel#playlistCardTitle {
    font-size: 13px;
    font-weight: 650;
    color: ${title};
    background: transparent;
    padding: 2px 2px 0 2px;
}

QFrame#quickPickTile {
    background: transparent;
    border: none;
    border-radius: 14px;
}

QLabel#quickPickTitle {
    font-size: 13px;
    font-weight: 650;
    color: ${title};
    background: transparent;
}

QToolButton#homeSectionAction {
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 7px 14px;
    color: ${text_soft};
    font-size: 12px;
    font-weight: 600;
}

QToolButton#homeSectionAction:hover {
    background: rgba(${hl_rgb}, 0.14);
    border-color: rgba(46, 230, 255, 0.55);
    color: ${title};
}

QTableView#homeTrackList {
    background: transparent;
    border: none;
    outline: none;
}

QTableView#homeTrackList::item {
    border: none;
    padding: 0;
    background: transparent;
}

QTableView#homeTrackList::item:selected {
    background: transparent;
}

QTableView#homeTrackList QScrollBar:vertical,
QTableView#homeTrackList QScrollBar:horizontal {
    width: 0;
    height: 0;
    background: transparent;
}

QFrame#featuredPanel {
    min-height: 148px;
    max-height: 168px;
    background: transparent;
    border: none;
    border-radius: 18px;
}

QLabel#featuredTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: ${title};
    background: transparent;
}

QLabel#featuredAuthor {
    font-size: 13px;
    color: rgba(${mist_rgb}, 0.62);
    background: transparent;
}

QToolButton#featuredPlayBtn {
    background: ${title};
    border: none;
    border-radius: 22px;
    color: #0b0d12;
    font-size: 14px;
    font-weight: 700;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0;
    font-family: ${font_label};
}

QToolButton#featuredPlayBtn:hover {
    background: #ffffff;
    color: #0b0d12;
}

QToolButton#featuredPlayBtn:disabled {
    background: rgba(${ink_rgb}, 0.08);
    color: rgba(248, 250, 252, 0.32);
}

QFrame#wavePromoCard {
    background: transparent;
    border: none;
    border-radius: 18px;
}

QLabel#wavePromoSubtitle {
    font-size: 12px;
    color: rgba(${mist_rgb}, 0.55);
    background: transparent;
}

QLabel#wavePromoCount {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: rgba(125, 211, 252, 0.9);
    background: transparent;
    padding: 0;
}

QToolButton#wavePromoPlayBtn {
    background: rgba(${hl_rgb}, 0.12);
    border: 1px solid rgba(${hl_rgb}, 0.28);
    border-radius: 22px;
    color: #e8fcff;
    font-size: 13px;
    font-weight: 700;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0;
}

QToolButton#wavePromoPlayBtn:hover {
    background: rgba(46, 230, 255, 0.28);
    border-color: rgba(46, 230, 255, 0.5);
    color: #ffffff;
}

QToolButton#wavePromoPlayBtn:disabled {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.06);
    color: rgba(248, 250, 252, 0.28);
}

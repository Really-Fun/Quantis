QWidget#homePage,
QWidget#homeScrollContent,
QWidget#libraryPage {
    background: transparent;
}

QScrollArea#homeScroll {
    background: transparent;
    border: none;
}

QWidget#playlistShelf,
QWidget#quickPickShelf,
QWidget#playlistShelfHost,
QWidget#quickPickShelfHost {
    background: transparent;
}

QLabel#homeGreetingSub {
    font-size: 14px;
    font-weight: 400;
    color: rgba(${mist_rgb}, 0.55);
    letter-spacing: 0.15px;
    padding: 0 0 8px 0;
    background: transparent;
}

QWidget#homeSection,
QWidget#homeSectionBody {
    background: transparent;
}

QLabel#homeSectionTitle {
    font-size: 22px;
    font-weight: 700;
    color: ${title};
    letter-spacing: -0.45px;
    background: transparent;
    font-family: ${font_display};
}

QLabel#homeSectionSubtitle {
    font-size: 12px;
    color: rgba(${mist_rgb}, 0.45);
    background: transparent;
    font-family: ${font_label};
}

QLabel#homeSectionBadge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: rgba(${mist_rgb}, 0.75);
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: 8px;
    min-width: 20px;
    padding: 2px 8px;
    max-height: 20px;
}

QLabel#homePillBadge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.25px;
    color: rgba(${mist_rgb}, 0.82);
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: 8px;
    padding: 2px 8px;
    max-height: 20px;
}

QLabel#homePillBadge[variant="wave"] {
    color: rgba(125, 211, 252, 0.95);
    background: rgba(${hl_rgb}, 0.07);
    border-color: rgba(${hl_rgb}, 0.2);
}

QLabel#homePillBadge[variant="continue"] {
    color: rgba(253, 186, 210, 0.95);
    background: rgba(255, 92, 122, 0.08);
    border-color: rgba(255, 92, 122, 0.22);
}

QLabel#homeEmptyHint {
    font-size: 13px;
    color: rgba(${mist_rgb}, 0.4);
    padding: 16px 4px;
    background: transparent;
}

QFrame#playlistCard {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#playlistCard[hovered="true"] QLabel#playlistCardTitle {
    color: rgb(${hl_rgb});
}

QLabel#playlistCardTitle {
    font-size: 13px;
    font-weight: 650;
    color: ${title};
    background: transparent;
    padding: 2px 2px 0 2px;
}

QFrame#quickPickTile {
    background: transparent;
    border: none;
    border-radius: 14px;
}

QLabel#quickPickTitle {
    font-size: 13px;
    font-weight: 650;
    color: ${title};
    background: transparent;
}

QToolButton#homeSectionAction {
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(${ink_rgb}, 0.14);
    border-radius: 12px;
    padding: 7px 14px;
    color: ${text_soft};
    font-size: 12px;
    font-weight: 600;
}

QToolButton#homeSectionAction:hover {
    background: rgba(${hl_rgb}, 0.14);
    border-color: rgba(${hl_rgb}, 0.55);
    color: ${title};
}

QTableView#homeTrackList {
    background: transparent;
    border: none;
    outline: none;
}

QTableView#homeTrackList::item {
    border: none;
    padding: 0;
    background: transparent;
}

QTableView#homeTrackList::item:selected {
    background: transparent;
}

QTableView#homeTrackList QScrollBar:vertical,
QTableView#homeTrackList QScrollBar:horizontal {
    width: 0;
    height: 0;
    background: transparent;
}


/* Сцена «Сейчас играет» */
QLabel#stageKicker {
    color: ${text_soft};
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QLabel#stageTitle {
    color: ${title};
    font-family: ${font_display};
    font-size: 40px;
    font-weight: 700;
    background: transparent;
}

QLabel#stageTitle[compact="true"] {
    font-size: 30px;
}

QLabel#stageArtist {
    color: ${text_soft};
    font-size: 15px;
    font-weight: 500;
    background: transparent;
}

QLabel#stageChipLabel {
    color: ${text_dim};
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

QPushButton#stagePill {
    color: ${text};
    font-size: 13px;
    font-weight: 600;
    background: rgba(${ink_rgb}, 0.08);
    border: 1px solid rgba(${ink_rgb}, 0.16);
    border-radius: 16px;
    min-height: 30px;
    padding: 0 16px;
}

QPushButton#stagePill:hover {
    background: rgba(${ink_rgb}, 0.14);
}

/* «Моя волна» — первая плитка быстрого доступа */
QLabel#quickPickSubtitle {
    color: ${text_dim};
    font-size: 12px;
    background: transparent;
}

QToolButton#waveQuickPlay {
    color: ${on_tint};
    background: ${tint};
    border: none;
    border-radius: 18px;
    font-size: 13px;
}

QToolButton#waveQuickPlay:hover {
    background: ${tint_hover};
}

QToolButton#waveQuickPlay:disabled {
    background: rgba(${ink_rgb}, 0.1);
    color: rgba(${ink_rgb}, 0.35);
}

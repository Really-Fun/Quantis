QLabel#settingsSectionLabel {
    color: rgb(${hl_rgb});
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    padding: 12px 0 4px 0;
    background: transparent;
    font-family: ${font_label};
}

QLabel#settingsRowTitle {
    color: ${title};
    font-size: 15px;
    font-weight: 650;
    background: transparent;
    font-family: ${font_display};
}

QLabel#settingsRowDesc {
    color: rgba(${mist_rgb}, 0.68);
    font-size: 12px;
    background: transparent;
}

QCheckBox#settingsCheck {
    color: ${text_soft};
    font-size: 14px;
    font-weight: 560;
    spacing: 10px;
    padding: 4px 2px;
    background: transparent;
}

QComboBox#themeCombo,
QLineEdit#settingLineEdit {
    background: ${field_bg};
    border: 1px solid rgba(${ink_rgb}, 0.1);
    border-radius: 12px;
    padding: 10px 12px;
    color: ${title};
    font-size: 13px;
    min-height: 20px;
    font-family: ${font_display};
}

QComboBox#themeCombo:hover,
QLineEdit#settingLineEdit:focus {
    border-color: rgba(46, 230, 255, 0.55);
    background: rgba(0, 0, 0, 0.52);
}

QComboBox#themeCombo QAbstractItemView {
    background: #080e18;
    color: ${title};
    border: 1px solid rgba(${ink_rgb}, 0.1);
    selection-background-color: rgba(46, 230, 255, 0.28);
    outline: none;
    padding: 4px;
}

QWidget#settingsPage {
    background: transparent;
}

QFrame#settingsPanel {
    background: rgba(8, 12, 22, 0.86);
    border: 1px solid rgba(46, 230, 255, 0.12);
    border-radius: 24px;
}

QFrame#settingsRow {
    background: rgba(${ink_rgb}, 0.035);
    border: 1px solid rgba(${ink_rgb}, 0.07);
    border-radius: 16px;
    padding: 14px 16px;
}

QCheckBox#settingsCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(0, 0, 0, 0.35);
}

QCheckBox#settingsCheck::indicator:checked {
    background: rgb(${hl_rgb});
    border-color: rgb(${hl_rgb});
}

QSpinBox#settingSpin {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 12px;
    color: ${title};
    font-size: 13px;
    min-height: 20px;
}

QSpinBox#settingSpin:hover,
QSpinBox#settingSpin:focus {
    border-color: rgba(46, 230, 255, 0.55);
    background: rgba(0, 0, 0, 0.52);
}

QComboBox#themeCombo::drop-down {
    border: none;
    width: 28px;
}

QPushButton#settingsButton {
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 8px 14px;
    color: ${text_soft};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#settingsButton:hover {
    background: rgba(${hl_rgb}, 0.14);
    border-color: rgba(46, 230, 255, 0.55);
    color: ${title};
}

QPushButton#settingsButton:pressed {
    background: rgba(46, 230, 255, 0.26);
}

QFrame#updateBanner {
    background: rgba(46, 230, 255, 0.12);
    border: none;
    border-bottom: 1px solid rgba(46, 230, 255, 0.22);
}

QLabel#updateBannerText {
    color: ${title};
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QPushButton#updateBannerButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 6px 12px;
    color: ${text_soft};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#updateBannerButton:hover {
    background: rgba(${hl_rgb}, 0.14);
    border-color: rgba(46, 230, 255, 0.55);
    color: ${title};
}

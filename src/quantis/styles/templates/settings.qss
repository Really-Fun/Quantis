QLabel#settingsSectionLabel {
    color: rgb(${hl_rgb});
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    padding: 12px 0 4px 0;
    background: transparent;
    font-family: ${font_label};
}

QLabel#settingsRowTitle {
    color: ${title};
    font-size: 15px;
    font-weight: 650;
    background: transparent;
    font-family: ${font_ui};
}

QLabel#settingsRowDesc {
    color: rgba(${mist_rgb}, 0.68);
    font-size: 12px;
    background: transparent;
}

QCheckBox#settingsCheck {
    color: ${text_soft};
    font-size: 14px;
    font-weight: 560;
    spacing: 10px;
    padding: 4px 2px;
    background: transparent;
}

QComboBox#themeCombo,
QLineEdit#settingLineEdit {
    background: ${field_bg};
    border: 1px solid rgba(${ink_rgb}, 0.1);
    border-radius: 12px;
    padding: 10px 12px;
    color: ${title};
    font-size: 13px;
    min-height: 20px;
    font-family: ${font_ui};
}

QComboBox#themeCombo:hover,
QLineEdit#settingLineEdit:focus {
    border-color: rgba(${hl_rgb}, 0.55);
    background: ${field_bg};
}

QComboBox#themeCombo QAbstractItemView {
    background: ${list_bg};
    color: ${title};
    border: 1px solid rgba(${ink_rgb}, 0.1);
    selection-background-color: rgba(${hl_rgb}, 0.28);
    outline: none;
    padding: 4px;
}

QWidget#settingsPage {
    background: transparent;
}

QFrame#settingsPanel {
    background: ${surface};
    border: 1px solid rgba(${hl_rgb}, 0.12);
    border-radius: 24px;
}

QFrame#settingsRow {
    background: rgba(${ink_rgb}, 0.035);
    border: 1px solid rgba(${ink_rgb}, 0.07);
    border-radius: 16px;
    padding: 14px 16px;
}

QCheckBox#settingsCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid rgba(${ink_rgb}, 0.28);
    background: ${field_bg};
}

QCheckBox#settingsCheck::indicator:checked {
    background: rgb(${hl_rgb});
    border-color: rgb(${hl_rgb});
}

QSpinBox#settingSpin {
    background: ${field_bg};
    border: 1px solid rgba(${ink_rgb}, 0.12);
    border-radius: 12px;
    padding: 10px 12px;
    color: ${title};
    font-size: 13px;
    min-height: 20px;
}

QSpinBox#settingSpin:hover,
QSpinBox#settingSpin:focus {
    border-color: rgba(${hl_rgb}, 0.55);
    background: ${field_bg};
}

QComboBox#themeCombo::drop-down {
    border: none;
    width: 28px;
}

QPushButton#settingsButton {
    background: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(${ink_rgb}, 0.14);
    border-radius: 12px;
    padding: 8px 14px;
    color: ${text_soft};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#settingsButton:hover {
    background: rgba(${hl_rgb}, 0.14);
    border-color: rgba(${hl_rgb}, 0.55);
    color: ${title};
}

QPushButton#settingsButton:pressed {
    background: rgba(${hl_rgb}, 0.26);
}

QFrame#updateBanner {
    background: rgba(${hl_rgb}, 0.12);
    border: none;
    border-bottom: 1px solid rgba(${hl_rgb}, 0.22);
}

QLabel#updateBannerText {
    color: ${title};
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QPushButton#updateBannerButton {
    background: rgba(${ink_rgb}, 0.06);
    border: 1px solid rgba(${ink_rgb}, 0.14);
    border-radius: 10px;
    padding: 6px 12px;
    color: ${text_soft};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#updateBannerButton:hover {
    background: rgba(${hl_rgb}, 0.14);
    border-color: rgba(${hl_rgb}, 0.55);
    color: ${title};
}

/* --- Аккаунты --- */

QLabel#memberTitle {
    color: ${title};
    font-size: 26px;
    font-weight: 700;
    background: transparent;
    font-family: ${font_display};
}

QLabel#memberSubtitle {
    color: rgba(${mist_rgb}, 0.72);
    font-size: 13px;
    background: transparent;
}

QFrame#memberCard {
    background: rgba(${ink_rgb}, 0.035);
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: 18px;
}

QFrame#memberDivider {
    background: rgba(${ink_rgb}, 0.08);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QLabel#memberService {
    color: ${title};
    font-size: 17px;
    font-weight: 700;
    background: transparent;
    font-family: ${font_ui};
}

QLabel#memberDot {
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}

QLabel#memberDot[source="yandex"] {
    background: #FFCC00;
}

QLabel#memberDot[source="youtube"] {
    background: #FF3D3D;
}

QLabel#memberChip {
    border-radius: 11px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 650;
    font-family: ${font_label};
    background: rgba(${ink_rgb}, 0.07);
    color: ${text_soft};
}

QLabel#memberChip[state="ok"] {
    background: rgba(${ok_rgb}, 0.16);
    color: rgb(${ok_rgb});
}

QLabel#memberChip[state="limited"],
QLabel#memberChip[state="expired"] {
    background: rgba(${warn_rgb}, 0.16);
    color: rgb(${warn_rgb});
}

QLabel#memberChip[state="error"] {
    background: rgba(${bad_rgb}, 0.16);
    color: rgb(${bad_rgb});
}

QLabel#memberAccount {
    color: ${title};
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

QLabel#memberDetail {
    color: rgba(${mist_rgb}, 0.82);
    font-size: 13px;
    background: transparent;
}

QLabel#memberFieldLabel {
    color: ${text_soft};
    font-size: 12px;
    font-weight: 650;
    background: transparent;
    font-family: ${font_label};
}

QLabel#memberFeedback {
    font-size: 12px;
    background: transparent;
    color: rgba(${mist_rgb}, 0.72);
}

QLabel#memberFeedback[state="ok"] {
    color: rgb(${ok_rgb});
}

QLabel#memberFeedback[state="warn"] {
    color: rgb(${warn_rgb});
}

QLabel#memberFeedback[state="error"] {
    color: rgb(${bad_rgb});
}

QPlainTextEdit#memberCookieEdit {
    background: ${field_bg};
    border: 1px solid rgba(${ink_rgb}, 0.1);
    border-radius: 12px;
    padding: 8px 10px;
    color: ${title};
    font-size: 12px;
    font-family: ${font_mono};
}

QPlainTextEdit#memberCookieEdit:focus {
    border-color: rgba(${hl_rgb}, 0.55);
}

QToolButton#memberGuideToggle {
    background: transparent;
    border: none;
    color: rgb(${hl_rgb});
    font-size: 12px;
    font-weight: 650;
    padding: 2px 0;
}

QToolButton#memberGuideToggle:hover {
    color: ${title};
}

QLabel#memberGuide {
    background: rgba(${ink_rgb}, 0.04);
    border-radius: 12px;
    padding: 12px 14px;
    color: ${text_soft};
    font-size: 12px;
}

QPushButton#memberDanger {
    background: transparent;
    border: 1px solid rgba(${bad_rgb}, 0.35);
    border-radius: 12px;
    padding: 8px 14px;
    color: rgb(${bad_rgb});
    font-size: 12px;
    font-weight: 600;
}

QPushButton#memberDanger:hover {
    background: rgba(${bad_rgb}, 0.12);
}

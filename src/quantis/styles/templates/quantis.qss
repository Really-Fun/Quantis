* {
    font-family: ${font_ui};
}

QWidget#appShell,
QWidget#appContent,
QWidget#bodyWithWallpaper,
QWidget#bodyForeground,
QWidget#wallpaperBackdrop,
QWidget#backgroundLayerHost,
QMainWindow,
QWidget#pageStack {
    background: transparent;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QScrollArea#settingsScroll > QWidget > QWidget {
    background: transparent;
}

QListView#trackList,
QTableView#trackList {
    background: transparent;
    border: none;
    outline: none;
}

QListView#trackList::item {
    border: none;
    padding: 0;
    background: transparent;
}

QListView#trackList::item:selected {
    background: transparent;
}

QFrame#appHeader {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-height: 52px;
    border: none;
    border-bottom: 1px solid rgba(${ink_rgb}, 0.05);
}

QFrame#appHeader QLabel#headerGreeting {
    font-size: 14px;
    font-weight: 650;
    letter-spacing: 0.2px;
}

QLabel#headerSub {
    font-size: 11px;
    color: rgba(${mist_rgb}, 0.45);
    letter-spacing: 0.4px;
}

QLabel#headerBrandWordmark {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 2.4px;
    color: ${title};
    background: transparent;
}

QToolButton#windowHideUiBtn,
QToolButton#windowMinBtn,
QToolButton#windowMaxBtn,
QToolButton#windowCloseBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 0;
    margin: 0;
}

QToolButton#windowHideUiBtn:hover,
QToolButton#windowMinBtn:hover,
QToolButton#windowMaxBtn:hover {
    background: rgba(${ink_rgb}, 0.08);
}

QToolButton#windowCloseBtn:hover {
    background: #e81123;
}

QToolButton#windowCloseBtn:pressed {
    background: #bf0f1d;
}

QLabel#headerBrandMark {
    background: transparent;
    border: none;
}

QFrame#sideNavRail QToolButton#navIconButton {
    outline: none;
}

QWidget#statsPage,
QWidget#statsMetrics {
    background: transparent;
}

QFrame#statsMetric {
    background-color: rgba(${ink_rgb}, 0.05);
    border: 1px solid rgba(${ink_rgb}, 0.08);
    border-radius: 18px;
}

QLabel#statsMetricValue {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: ${title};
    background: transparent;
}

QLabel#statsMetricLabel {
    font-size: 12px;
    font-weight: 500;
    color: rgba(${mist_rgb}, 0.48);
    background: transparent;
}

QWidget#listenBars {
    background: transparent;
    min-height: 48px;
}

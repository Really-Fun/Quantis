/* =========================================
   ГЛОБАЛЬНЫЕ СТИЛИ (База и Окна)
   ========================================= */
#darkOverlay {
    /* Чуть более выраженное затемнение при открытых диалогах */
    background-color: rgba(0, 0, 0, 140);
}
QMenu, QMessageBox, QDialog, QToolTip, QInputDialog {
    /* Окна делаем солидно-темными, но мягкими */
    background-color: rgba(10, 12, 20, 220);
    color: white;
    border: 2px solid rgba(0, 220, 255, 150);
    border-radius: 14px;
}

QMessageBox QLabel, QInputDialog QLabel {
    color: rgba(255, 255, 255, 240);
    font-size: 14px;
}

QMessageBox QPushButton, QInputDialog QPushButton {
    background-color: rgba(0, 220, 255, 30);
    border: 1px solid rgba(0, 220, 255, 150);
    border-radius: 8px;
    color: white;
    padding: 6px 16px;
    min-width: 80px;
    font-weight: bold;
}

QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
    background-color: rgba(0, 220, 255, 100);
    border: 1px solid rgba(0, 220, 255, 255);
}

/* Стилизация выпадающего списка в QInputDialog */
QInputDialog QComboBox {
    background-color: rgba(0, 0, 0, 140);
    border: 1px solid rgba(0, 220, 255, 120);
    border-radius: 8px;
    color: white;
    padding: 6px 12px;
    font-size: 14px;
}
QInputDialog QComboBox::drop-down {
    border: none;
}
QInputDialog QComboBox QAbstractItemView {
    background-color: #0b0d16;
    color: white;
    border: 1px solid rgba(0, 220, 255, 120);
    selection-background-color: rgba(0, 220, 255, 120);
    selection-color: white;
    outline: none;
}

/* =========================================
   ТИПОГРАФИКА И ТЕКСТЫ
   ========================================= */
#headerGreeting, #playlistName, #sectionTitle, #trackTitle, #playlistTitle {
    color: #f8fafc;
}
#headerGreeting {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    background: transparent;
}
#headerSub {
    color: rgba(255, 255, 255, 170);
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}
#playlistName { font-size: 28px; font-weight: 800; }
#sectionTitle { font-size: 17px; font-weight: 700; }
#trackTitle { font-size: 14px; font-weight: 600; }
#playlistTitle { font-size: 13px; font-weight: 600; }

#headerSub, #emptyLabel { color: rgba(255,255,255,200); font-size: 13px; }
#headerSub { font-weight: 500; }
#emptyLabel { padding: 20px; }

#colHeaderNum, #colHeaderTitle, #colHeaderSource { color: rgba(255,255,255,180); }
#colHeaderNum { font-size: 12px; }
#colHeaderTitle, #colHeaderSource { font-size: 11px; font-weight: 600; }

#playlistTag { color: rgba(0, 220, 255, 255); font-size: 11px; font-weight: 700; letter-spacing: 2px; }

#timeLabel, #playlistCount, #trackIndex { color: rgba(255,255,255,220); }
#timeLabel { font-size: 11px; }
#playlistCount, #trackIndex { font-size: 13px; }
#trackIndex[state="playing"] { color: rgb(0,220,255); font-weight: 700; }

#trackArtist, #trackAuthor { color: rgba(255,255,255,200); }
#trackArtist { font-size: 11px; }
#trackAuthor { font-size: 12px; }

#volIcon { color: #fff; font-size: 14px; }

#sectionIcon { font-size: 18px; color: #fff; }
#settingLabel { color: rgba(255,255,255,240); font-size: 14px; }
#settingValueLabel { color: rgba(255,255,255,220); font-size: 12px; }
#settingSubLabel { color: rgba(255,255,255,160); font-size: 12px; }
#settingAccentLabel { color: rgba(0,220,255,240); font-size: 13px; }

/* =========================================
   КНОПКИ УПРАВЛЕНИЯ
   ========================================= */
#controlButton, #repeatButton, QToolButton#roundButton {
    border: none;
    outline: none;
    background: transparent;
}
#controlButton:hover, #repeatButton:hover {
    background: rgba(255,255,255,40);
}

#repeatButton[state="active"] { background: rgba(0,220,255,80); }
#repeatButton[state="active"]:hover { background: rgba(0,220,255,120); }

#actionButton[accent="true"], #actionButton[accent="false"] {
    font-size: 13px;
    border: none;
    border-radius: 16px;
    padding: 8px 20px;
}
#actionButton[accent="true"] { color: #000; font-weight: 700; background: rgb(0,220,255); }
#actionButton[accent="true"]:hover { background: rgb(40,240,255); }
#actionButton[accent="false"] { color: #fff; font-weight: 600; background: rgba(255,255,255,40); }
#actionButton[accent="false"]:hover { background: rgba(255,255,255,60); }

#createPlaylistBtn { color: white; font-size: 14px; font-weight: 700; border: none; border-radius: 11px; background: rgba(255,255,255,40); }
#createPlaylistBtn:hover { background: rgba(0,220,255,100); }

#backButton { color: white; font-size: 18px; font-weight: 700; background: rgba(0,0,0,140); border-radius: 18px; border: none; }
#backButton:hover { background: rgba(0,220,255,120); }

#playOverlayBtn { background: rgba(0, 0, 0, 150); border: none; border-radius: 12px; }
#playOverlayBtn:hover { background: rgba(0, 0, 0, 200); }

#downloadBtn { background: rgba(255, 255, 255, 40); border: none; border-radius: 14px; }
#downloadBtn:hover { background: rgba(0, 220, 255, 120); }

/* =========================================
   ПОЛЗУНКИ (Слайдеры)
   ========================================= */
#seekSlider::groove:horizontal, #volSlider::groove:horizontal {
    height: 4px;
    background: rgba(255,255,255,80);
    border-radius: 2px;
}
#seekSlider::handle:horizontal, #volSlider::handle:horizontal {
    background: #fff;
}
#seekSlider::handle:horizontal { width: 12px; height: 12px; margin: -4px 0; border-radius: 6px; }
#volSlider::handle:horizontal { width: 10px; height: 10px; margin: -3px 0; border-radius: 5px; }

#seekSlider::handle:horizontal:hover { background: rgb(0,220,255); }

#seekSlider::sub-page:horizontal { background: rgb(0,220,255); border-radius: 2px; }
#volSlider::sub-page:horizontal { background: rgba(0,220,255,220); border-radius: 2px; }

/* =========================================
   СКРОЛЛБАРЫ И СПИСКИ
   ========================================= */
QScrollArea, #trackListView { border: none; outline: none; background: transparent; }
#trackListView::item:hover { background: transparent; }

QScrollBar:vertical {
    width: 6px;
    background: transparent;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,120);
    border-radius: 3px;
    min-height: 30px;
}
#trackListView QScrollBar::handle:vertical {
    background: rgba(0, 220, 255, 140);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* Панель треков — базовая поверхность в surfaces.qss */
#listDivider { background: rgba(255, 255, 255, 0.08); }

/* =========================================
   ПАНЕЛЬ НАВИГАЦИИ (ЛЕВАЯ)
   ========================================= */
QFrame#navPanel {
    background: rgba(0, 0, 0, 110); /* Боковая панель теперь мягко притемняет левую часть фона */
    border-right: 1px solid rgba(0, 220, 255, 60);
}

/* =========================================
   НИЖНЯЯ ПАНЕЛЬ ПЛЕЕРА
   ========================================= */
/* Нижняя панель — базовая поверхность в surfaces.qss; акцент в theme play_menu.qss */
QPushButton#navButton { color: #e6ffff; font-size: 16px; border-radius: 10px; background: transparent; }
QPushButton#navButton:hover { background: rgba(0, 255, 255, 60); }
QPushButton#navButton:pressed { background: rgba(0, 255, 255, 120); }
QPushButton#navButton:checked { background: rgba(0, 220, 255, 160); color: white; }

/* =========================================
   БЕЙДЖИ И ОБЛОЖКИ
   ========================================= */
#systemBadge { color: rgba(0,220,255,255); font-size: 10px; font-weight: 700; letter-spacing: 1px; background: rgba(0,220,255,60); border-radius: 6px; padding: 2px 8px; }

#trackSourceBadge { color: white; font-size: 11px; font-weight: 600; border-radius: 6px; padding: 2px 8px; }
#trackSourceBadge[source="yandex"] { background: rgba(0, 220, 255, 200); }
#trackSourceBadge[source="youtube"] { background: rgba(255, 40, 40, 200); }
#trackSourceBadge[source="default"] { background: rgba(140, 140, 140, 200); }

#coverLabel { border-radius: 8px; background: rgba(255, 255, 255, 0.06); }
#trackCover { background: rgba(0, 0, 0, 100); border-radius: 12px; }

/* =========================================
   КАРТОЧКА ТРЕКА
   ========================================= */
#TrackCard { background-color: rgba(0, 0, 0, 50); border-radius: 10px; }
#TrackCard:hover { background-color: rgba(0, 220, 255, 50); }
#TrackCard[playing="true"] { background-color: rgba(0, 220, 255, 80); border: 1px solid rgba(0, 220, 255, 140); }

/* =========================================
   ГЛАВНАЯ СТРАНИЦА
   ========================================= */
#HeaderPanel {
    /* Сбалансированный темный градиент для плашки приветствия */
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(0, 0, 0, 150),
        stop: 0.5 rgba(0, 0, 0, 90),
        stop: 1 rgba(0, 0, 0, 150));
    border-radius: 16px;
    border-bottom: 1px solid rgba(0, 220, 255, 60);
}

#PlaylistSection {
    background-color: rgba(0, 0, 0, 90);
    border-radius: 16px;
}
#PlaylistSection[accent="true"] {
    border-top: 1px solid rgba(0, 220, 255, 80);
}

/* =========================================
   СТРАНИЦА НАСТРОЕК
   ========================================= */
#SettingsHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(0, 0, 0, 150),
        stop: 0.5 rgba(0, 0, 0, 90),
        stop: 1 rgba(0, 0, 0, 150));
    border-radius: 16px;
    border-bottom: 1px solid rgba(0, 220, 255, 60);
}

#SettingsSection {
    background-color: rgba(0, 0, 0, 100);
    border-radius: 16px;
}

#settingLineEdit {
    color: white;
    background: rgba(0, 0, 0, 120);
    border: 1px solid rgba(0, 220, 255, 80);
    border-radius: 8px;
    padding: 6px;
}

/* =========================================
   СТРАНИЦА ПЛЕЙЛИСТА
   ========================================= */
#PlaylistHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(0, 0, 0, 140),
        stop: 0.4 rgba(0, 0, 0, 80),
        stop: 1 rgba(0, 0, 0, 140));
    border-radius: 16px;
    border-bottom: 1px solid rgba(0, 220, 255, 60);
}

/* =========================================
   ВЫПАДАЮЩИЕ СПИСКИ НАСТРОЕК
   ========================================= */
#settingsCombo {
    color: white;
    background: rgba(0, 0, 0, 130);
    border: 1px solid rgba(0, 220, 255, 80);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    min-width: 120px;
}
#settingsCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 20px;
    border: none;
}
#settingsCombo QAbstractItemView {
    color: white;
    background: #0b0d16;
    selection-background-color: rgba(0, 220, 255, 120);
    border: 1px solid rgba(0, 220, 255, 120);
    outline: none;
}

/* =========================================
   ЗОНА ПРОКРУТКИ
   ========================================= */
#settingsScroll {
    background: transparent;
    border: none;
}
#_sc {
    background: transparent;
}
#settingsScroll QScrollBar::handle:vertical {
    background: rgba(0, 220, 255, 120);
}

/* =========================================
   СТРАНИЦА ПОИСКА
   ========================================= */
#searchInput {
    padding: 14px 18px;
    font-size: 16px;
    color: white;
    background: rgba(0, 0, 0, 140);
    border: 1px solid rgba(0, 220, 255, 80);
    border-radius: 14px;
    selection-background-color: rgba(0, 220, 255, 120);
}
#searchInput::placeholder {
    color: rgba(255, 255, 255, 200);
}

#ResultsPanel {
    background: rgba(0, 0, 0, 110);
    border-radius: 14px;
}

#searchStatusLabel {
    color: rgba(255, 255, 255, 220);
    font-size: 14px;
    padding: 24px;
    background: transparent;
}

QLabel#playlistCoverLabelOnly {
    background-color: transparent !important;
    background: transparent !important;
    border: none !important;
    padding: 0px !important;
}
/* Light — фарфор + чернила, акцент Aurora */

QWidget {
    background: transparent;
    color: #1B2030;
}

#darkOverlay {
    background-color: rgba(244, 245, 249, 188);
}

QMenu, QMessageBox, QDialog, QToolTip, QInputDialog {
    background-color: #F7F8FB;
    color: #1B2030;
    border: 1px solid rgba(27, 32, 48, 0.10);
    border-radius: 16px;
}

QMessageBox QLabel, QInputDialog QLabel {
    color: #667085;
    font-size: 14px;
}

QMessageBox QPushButton, QInputDialog QPushButton {
    background-color: rgba(108, 92, 231, 0.12);
    border: 1px solid rgba(108, 92, 231, 0.28);
    border-radius: 10px;
    color: #1B2030;
    padding: 6px 16px;
    min-width: 80px;
    font-weight: 700;
}

QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
    background-color: #6C5CE7;
    border-color: #6C5CE7;
    color: #FFFFFF;
}

QInputDialog QComboBox {
    background-color: rgba(27, 32, 48, 0.05);
    border: 1px solid rgba(27, 32, 48, 0.10);
    border-radius: 10px;
    color: #1B2030;
    padding: 6px 12px;
    font-size: 14px;
}
QInputDialog QComboBox::drop-down {
    border: none;
}
QInputDialog QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1B2030;
    border: 1px solid rgba(27, 32, 48, 0.10);
    selection-background-color: rgba(108, 92, 231, 0.18);
    selection-color: #1B2030;
    outline: none;
}

#headerGreeting, #playlistName, #sectionTitle, #trackTitle, #playlistTitle {
    color: #1B2030;
}
#headerGreeting {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    background: transparent;
}
#playlistName { font-size: 28px; font-weight: 800; }
#sectionTitle { font-size: 17px; font-weight: 700; }
#trackTitle { font-size: 14px; font-weight: 600; }
#playlistTitle { font-size: 13px; font-weight: 600; }

#headerSub, #emptyLabel { color: #667085; font-size: 13px; }
#headerSub { font-weight: 500; background: transparent; }
#emptyLabel { padding: 20px; }

#colHeaderNum, #colHeaderTitle, #colHeaderSource { color: #98A2B3; }
#colHeaderNum { font-size: 12px; }
#colHeaderTitle, #colHeaderSource { font-size: 11px; font-weight: 600; }

#playlistTag {
    color: #6C5CE7;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

#timeLabel, #playlistCount, #trackIndex { color: #667085; }
#timeLabel { font-size: 11px; }
#playlistCount, #trackIndex { font-size: 13px; }
#trackIndex[state="playing"] { color: #6C5CE7; font-weight: 700; }

#trackArtist, #trackAuthor { color: #667085; }
#trackArtist { font-size: 11px; }
#trackAuthor { font-size: 12px; }

#volIcon { color: #1B2030; font-size: 14px; }

#sectionIcon { font-size: 18px; color: #1B2030; }
#settingLabel { color: #1B2030; font-size: 14px; }
#settingValueLabel { color: #3D4555; font-size: 12px; }
#settingSubLabel { color: #667085; font-size: 12px; }
#settingAccentLabel { color: #6C5CE7; font-size: 13px; }

#controlButton, #repeatButton, QToolButton#roundButton {
    border: none;
    outline: none;
    background: transparent;
}
#controlButton:hover, #repeatButton:hover {
    background: rgba(27, 32, 48, 0.06);
}

#repeatButton[state="active"] { background: rgba(108, 92, 231, 0.14); }
#repeatButton[state="active"]:hover { background: rgba(108, 92, 231, 0.22); }

#actionButton[accent="true"], #actionButton[accent="false"] {
    font-size: 13px;
    border: none;
    border-radius: 16px;
    padding: 8px 20px;
}
#actionButton[accent="true"] { color: #FFFFFF; font-weight: 700; background: #6C5CE7; }
#actionButton[accent="true"]:hover { background: #7F71F0; }
#actionButton[accent="false"] { color: #1B2030; font-weight: 600; background: rgba(27, 32, 48, 0.06); }
#actionButton[accent="false"]:hover { background: rgba(27, 32, 48, 0.10); }

#createPlaylistBtn {
    color: #1B2030;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 11px;
    background: rgba(27, 32, 48, 0.06);
}
#createPlaylistBtn:hover { background: rgba(108, 92, 231, 0.16); color: #1B2030; }

#backButton {
    color: #1B2030;
    font-size: 18px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(27, 32, 48, 0.08);
    border-radius: 18px;
}
#backButton:hover { background: rgba(108, 92, 231, 0.14); }

#playOverlayBtn { background: rgba(255, 255, 255, 0.88); border: none; border-radius: 12px; }
#playOverlayBtn:hover { background: #FFFFFF; }

#downloadBtn { background: rgba(27, 32, 48, 0.05); border: none; border-radius: 14px; }
#downloadBtn:hover { background: rgba(108, 92, 231, 0.14); }

#seekSlider::groove:horizontal, #volSlider::groove:horizontal {
    height: 4px;
    background: rgba(27, 32, 48, 0.10);
    border-radius: 2px;
}
#seekSlider::handle:horizontal, #volSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #6C5CE7;
}
#seekSlider::handle:horizontal { width: 12px; height: 12px; margin: -4px 0; border-radius: 6px; }
#volSlider::handle:horizontal { width: 10px; height: 10px; margin: -3px 0; border-radius: 5px; }

#seekSlider::handle:horizontal:hover { background: #6C5CE7; border-color: #FFFFFF; }

#seekSlider::sub-page:horizontal { background: #6C5CE7; border-radius: 2px; }
#volSlider::sub-page:horizontal { background: rgba(108, 92, 231, 0.55); border-radius: 2px; }

QScrollArea, #trackListView { border: none; outline: none; background: transparent; }
#trackListView::item:hover { background: transparent; }

QScrollBar:vertical {
    width: 6px;
    background: transparent;
}
QScrollBar::handle:vertical {
    background: rgba(108, 92, 231, 0.38);
    border-radius: 3px;
    min-height: 30px;
}
#trackListView QScrollBar::handle:vertical {
    background: rgba(108, 92, 231, 0.45);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

#listDivider { background: rgba(27, 32, 48, 0.08); }

QFrame#navPanel {
    background: rgba(255, 255, 255, 0.72);
    border-right: 1px solid rgba(108, 92, 231, 0.14);
}

#PlayMenu {
    background-color: rgba(255, 255, 255, 0.86);
    border-radius: 18px;
}
QPushButton#navButton { color: #667085; font-size: 16px; border-radius: 10px; background: transparent; }
QPushButton#navButton:hover { background: rgba(108, 92, 231, 0.10); color: #1B2030; }
QPushButton#navButton:pressed { background: rgba(108, 92, 231, 0.18); }
QPushButton#navButton:checked { background: #6C5CE7; color: #FFFFFF; }

#systemBadge {
    color: #6C5CE7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background: rgba(108, 92, 231, 0.12);
    border-radius: 6px;
    padding: 2px 8px;
}

#trackSourceBadge { color: white; font-size: 11px; font-weight: 600; border-radius: 6px; padding: 2px 8px; }
#trackSourceBadge[source="yandex"] { background: rgba(108, 92, 231, 0.88); }
#trackSourceBadge[source="youtube"] { background: rgba(255, 78, 69, 0.88); }
#trackSourceBadge[source="default"] { background: rgba(107, 114, 133, 0.78); }

#coverLabel { border-radius: 12px; background: rgba(27, 32, 48, 0.05); }
#trackCover { background: #E8EAF0; border-radius: 12px; }

#TrackCard { background-color: rgba(27, 32, 48, 0.04); border-radius: 10px; }
#TrackCard:hover { background-color: rgba(108, 92, 231, 0.08); }
#TrackCard[playing="true"] { background-color: rgba(108, 92, 231, 0.14); }

#HeaderPanel {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(255, 255, 255, 0.55),
        stop: 0.5 rgba(255, 255, 255, 0.78),
        stop: 1 rgba(255, 255, 255, 0.55));
    border-radius: 16px;
    border-bottom: 1px solid rgba(108, 92, 231, 0.12);
}

#PlaylistSection {
    background-color: rgba(255, 255, 255, 0.62);
    border-radius: 16px;
}
#PlaylistSection[accent="true"] {
    border-top: 1px solid rgba(108, 92, 231, 0.16);
}

#SettingsHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(255, 255, 255, 0.55),
        stop: 0.5 rgba(255, 255, 255, 0.78),
        stop: 1 rgba(255, 255, 255, 0.55));
    border-radius: 16px;
    border-bottom: 1px solid rgba(108, 92, 231, 0.12);
}

#SettingsSection {
    background-color: rgba(255, 255, 255, 0.62);
    border-radius: 16px;
}

#settingLineEdit {
    color: #1B2030;
    background: rgba(27, 32, 48, 0.05);
    border: 1px solid rgba(27, 32, 48, 0.10);
    border-radius: 10px;
    padding: 6px;
}

#PlaylistHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(255, 255, 255, 0.55),
        stop: 0.4 rgba(255, 255, 255, 0.78),
        stop: 1 rgba(255, 255, 255, 0.55));
    border-radius: 16px;
    border-bottom: 1px solid rgba(108, 92, 231, 0.12);
}

#settingsCombo {
    color: #1B2030;
    background: rgba(27, 32, 48, 0.05);
    border: 1px solid rgba(27, 32, 48, 0.10);
    border-radius: 10px;
    padding: 6px 12px;
    font-size: 13px;
    min-width: 120px;
}
#settingsCombo:hover {
    background: rgba(27, 32, 48, 0.08);
    border-color: rgba(108, 92, 231, 0.35);
}
#settingsCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 20px;
    border: none;
}
#settingsCombo QAbstractItemView {
    color: #1B2030;
    background: #FFFFFF;
    selection-background-color: rgba(108, 92, 231, 0.16);
    selection-color: #1B2030;
    border: 1px solid rgba(27, 32, 48, 0.10);
    outline: none;
}

#settingsScroll {
    background: transparent;
    border: none;
}
#_sc {
    background: transparent;
}
#settingsScroll QScrollBar::handle:vertical {
    background: rgba(108, 92, 231, 0.38);
    border-radius: 2px;
}
#settingsScroll QScrollBar::handle:vertical:hover {
    background: rgba(108, 92, 231, 0.55);
}

#searchInput {
    padding: 14px 18px;
    font-size: 16px;
    color: #1B2030;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(27, 32, 48, 0.08);
    border-radius: 14px;
    selection-background-color: rgba(108, 92, 231, 0.22);
}
#searchInput::placeholder {
    color: #98A2B3;
}

#ResultsPanel {
    background: rgba(255, 255, 255, 0.55);
    border-radius: 14px;
}

#searchStatusLabel {
    color: #667085;
    font-size: 14px;
    padding: 24px;
    background: transparent;
}

QLabel#playlistCoverLabelOnly {
    background-color: transparent !important;
    background: transparent !important;
    border: none !important;
    padding: 0px !important;
}

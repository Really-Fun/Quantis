/* Плейлист — акценты поверх surfaces.qss */

QWidget#playlistPage {
    background: transparent;
}

#TrackListPanel {
    border-top: 1px solid rgba(46, 230, 255, 0.22);
}

#listDivider {
    background: rgba(255, 255, 255, 0.07);
    border: none;
    max-height: 1px;
}

#playlistCoverFrame {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

#colHeaderNum,
#colHeaderTitle,
#colHeaderSource {
    color: rgba(255, 255, 255, 0.38);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    background: transparent;
}

QTableView#trackListView {
    background: transparent;
    border: none;
    outline: none;
}

QTableView#trackListView::item {
    border: none;
    padding: 0;
}

QTableView#trackListView::item:selected {
    background: transparent;
}

QTableView#trackListView QScrollBar:vertical {
    width: 5px;
    background: transparent;
    margin: 4px 0;
}

QTableView#trackListView QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    min-height: 40px;
}

QTableView#trackListView QScrollBar::add-line:vertical,
QTableView#trackListView QScrollBar::sub-line:vertical {
    height: 0;
}

#backButton {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
}

#backButton:hover {
    background: rgba(0, 220, 255, 0.16);
    border-color: rgba(0, 220, 255, 0.3);
}

#playlistTag {
    color: rgba(0, 220, 255, 0.75);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    background: transparent;
}

#playlistName {
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.4px;
    background: transparent;
}

#playlistCount {
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    background: transparent;
}

#actionButton[accent="true"] {
    color: #001018;
    font-size: 13px;
    font-weight: 700;
    background: rgb(0, 220, 255);
    border: none;
    border-radius: 18px;
    padding: 9px 22px;
    min-width: 116px;
}

#actionButton[accent="true"]:hover {
    background: rgb(80, 235, 255);
}

#actionButton[accent="false"] {
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 9px 22px;
    min-width: 132px;
}

#actionButton[accent="false"]:hover {
    background: rgba(255, 255, 255, 0.14);
}

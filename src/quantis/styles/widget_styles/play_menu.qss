/* Структура плеера — цвета в themes/<theme>/play_menu.qss */

QWidget#playerLeft,
QWidget#playerCenter,
QWidget#playerRight {
    background: transparent;
}

#trackTitle {
    font-size: 14px;
    font-weight: 650;
    background: transparent;
}
#trackArtist {
    font-size: 12px;
    background: transparent;
}
#timeLabel {
    font-size: 10px;
    font-family: "Cascadia Mono", "Consolas", "Bahnschrift", monospace;
    background: transparent;
}
#coverLabel {
    border-radius: 12px;
    min-width: 52px;
    max-width: 52px;
    min-height: 52px;
    max-height: 52px;
}

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
}
#seekSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
#volSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

#controlButton {
    border: none;
    border-radius: 20px;
    padding: 0;
    margin: 0;
}
#controlButton[accent=true] {
    border-radius: 20px;
    padding: 0;
    margin: 0;
}

#PlayMenu QLabel {
    background: transparent;
}

#controlButton[liked="true"] {
    background: rgba(255, 77, 109, 0.18);
}

#repeatButton {
    border: none;
    border-radius: 18px;
    padding: 0;
    margin: 0;
}
#repeatButton[state="active"] {
    background: rgba(255, 255, 255, 0.08);
}
#repeatButton[repeatMode="track"] {
    background: rgba(46, 230, 255, 0.14);
}

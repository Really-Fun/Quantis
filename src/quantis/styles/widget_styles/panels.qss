/*
 * Нейтральная база для панели «Сейчас», карточек плагинов, фильтров поиска
 * и кнопок боковой панели. Темы грузятся после общих стилей и перекрывают
 * эти правила своими цветами; без базы темы, где их нет, получали голые
 * системные кнопки.
 */

QToolButton#sourceFilterChip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px; /* Qt игнорирует радиус больше половины высоты */
    color: rgba(255, 255, 255, 0.6);
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QToolButton#sourceFilterChip:hover {
    background: rgba(255, 255, 255, 0.08);
}

QToolButton#sourceFilterChip:checked {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    color: #FFFFFF;
}

QFrame#nowPlayingPanel {
    background: rgba(20, 24, 33, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
}

#nowPlayingTitle {
    color: rgba(255, 255, 255, 0.95);
    font-size: 16px;
    font-weight: 700;
}

#nowPlayingArtist {
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
}

#nowPlayingSourceBtn,
#nowPlayingStubBtn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.92);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

#nowPlayingSourceBtn:hover,
#nowPlayingStubBtn:hover {
    background: rgba(255, 255, 255, 0.12);
}

QFrame#pluginCard {
    background: rgba(28, 33, 45, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
}

#pluginCardTitle { color: rgba(255, 255, 255, 0.95); font-size: 14px; font-weight: 700; }

#pluginCardAuthor { color: rgba(255, 255, 255, 0.55); font-size: 12px; }

#pluginCardDesc { color: rgba(255, 255, 255, 0.55); font-size: 12px; }

QLabel#navBrandLabel {
    color: rgba(255, 255, 255, 0.95);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QToolButton#navPinButton {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.55);
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
}

QToolButton#navPinButton:hover {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.95);
}

QToolButton#navPinButton:checked {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    color: #FFFFFF;
}

QToolButton#advancedToggle {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    color: rgba(255, 255, 255, 0.6);
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QToolButton#advancedToggle:hover {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.95);
}

QToolButton#advancedToggle:checked {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    color: #FFFFFF;
}

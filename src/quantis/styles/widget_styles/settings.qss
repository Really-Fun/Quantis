/* Настройки / Member — читаемые стеклянные блоки */

QWidget#settingsPage {
    background: transparent;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QFrame#settingsPanel {
    background: rgba(8, 12, 22, 0.86);
    border: 1px solid rgba(46, 230, 255, 0.12);
    border-radius: 24px;
}

QLabel#settingsSectionLabel {
    color: #2ee6ff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    padding: 12px 0 4px 0;
    background: transparent;
}

QFrame#settingsRow {
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    padding: 14px 16px;
}

QLabel#settingsRowTitle {
    color: #f8fafc;
    font-size: 15px;
    font-weight: 650;
    background: transparent;
}

QLabel#settingsRowDesc {
    color: rgba(226, 232, 240, 0.68);
    font-size: 12px;
    background: transparent;
}

QCheckBox#settingsCheck {
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 560;
    spacing: 10px;
    padding: 4px 2px;
    background: transparent;
}

QCheckBox#settingsCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(0, 0, 0, 0.35);
}

QCheckBox#settingsCheck::indicator:checked {
    background: #2ee6ff;
    border-color: #2ee6ff;
}

QComboBox#themeCombo,
QSpinBox#settingSpin,
QLineEdit#settingLineEdit {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 12px;
    color: #f8fafc;
    font-size: 13px;
    min-height: 20px;
}

QComboBox#themeCombo:hover,
QSpinBox#settingSpin:hover,
QSpinBox#settingSpin:focus,
QLineEdit#settingLineEdit:focus {
    border-color: rgba(46, 230, 255, 0.55);
    background: rgba(0, 0, 0, 0.52);
}

QComboBox#themeCombo::drop-down {
    border: none;
    width: 28px;
}

QPushButton#settingsButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 8px 14px;
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#settingsButton:hover {
    background: rgba(46, 230, 255, 0.16);
    border-color: rgba(46, 230, 255, 0.55);
    color: #f8fafc;
}

QPushButton#settingsButton:pressed {
    background: rgba(46, 230, 255, 0.26);
}

QFrame#updateBanner {
    background: rgba(46, 230, 255, 0.12);
    border: none;
    border-bottom: 1px solid rgba(46, 230, 255, 0.22);
}

QLabel#updateBannerText {
    color: #f8fafc;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QPushButton#updateBannerButton {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 6px 12px;
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#updateBannerButton:hover {
    background: rgba(46, 230, 255, 0.16);
    border-color: rgba(46, 230, 255, 0.55);
    color: #f8fafc;
}

QComboBox#themeCombo QAbstractItemView {
    background: #080e18;
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.12);
    selection-background-color: rgba(46, 230, 255, 0.28);
    outline: none;
    padding: 4px;
}

#playerDock {
    background: transparent;
    border: none;
    min-height: 80px;
}

#PlayMenu {
    background: rgba(20, 24, 33, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
}

#trackTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 650;
}
#trackTitle[playing="true"] { color: #00D9A3; }
#trackArtist { color: rgba(255, 255, 255, 0.6); font-size: 12px; }
#timeLabel { color: rgba(255, 255, 255, 0.55); }

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.12);
    height: 4px;
    border-radius: 2px;
}
#seekSlider::sub-page:horizontal {
    background: #00D9A3;
    border-radius: 2px;
}
#seekSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #00D9A3;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

#volSlider::sub-page:horizontal {
    background: rgba(0, 217, 163, 0.6);
    border-radius: 2px;
}
#volSlider::handle:horizontal {
    background: #FFFFFF;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

#controlButton {
    background: transparent;
    color: #FFFFFF;
    border-radius: 20px;
    padding: 0;
    margin: 0;
}
#controlButton:hover {
    background: rgba(255, 255, 255, 0.1);
}
#controlButton[accent=true] {
    background: #00D9A3;
    color: #0B0D12;
    border-radius: 20px;
    padding: 0;
    margin: 0;
}
#controlButton[accent=true]:hover {
    background: #1AE0B0;
}
#controlButton[liked="true"] {
    background: rgba(255, 78, 69, 0.25);
}
#repeatButton[state="active"] {
    background: rgba(255, 255, 255, 0.1);
}
#repeatButton[repeatMode="track"] {
    background: rgba(0, 217, 163, 0.18);
}

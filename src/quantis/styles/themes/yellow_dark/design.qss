/* Yellow dark — тёплый amber */

QWidget { color: #f0e8d8; }

QFrame#glassPanel {
    background: rgba(18, 14, 8, 0.85);
    border: none;
    border-radius: 14px;
}

QFrame#appHeader {
    background: rgba(14, 10, 6, 0.6);
    border: none;
}

#headerGreeting { font-size: 20px; font-weight: 700; color: #faf6ee; }
#sectionTitle {
    font-size: 13px; font-weight: 600;
    color: rgba(255, 170, 0, 0.7);
    letter-spacing: 0.5px; text-transform: uppercase;
}

#searchInput {
    background: rgba(0, 0, 0, 0.28);
    border: none;
    border-radius: 10px; padding: 12px 14px; font-size: 14px; color: #faf6ee;
}
#searchInput:focus { background: rgba(0, 0, 0, 0.4); }

QPushButton#searchButton {
    background: rgba(255, 170, 0, 0.18);
    border: none;
    border-radius: 10px; color: #faf6ee; font-weight: 600; padding: 8px 16px;
}
QPushButton#searchButton:hover { background: rgba(255, 170, 0, 0.28); }

#searchStatus { color: rgba(250, 246, 238, 0.4); font-size: 11px; }

QLabel#settingsSectionLabel {
    font-size: 11px; font-weight: 700; color: rgba(255, 170, 0, 0.65);
    letter-spacing: 1.5px; text-transform: uppercase;
}
QLabel#settingsRowTitle { color: #faf6ee; font-size: 14px; font-weight: 600; }
QLabel#settingsRowDesc { color: rgba(250, 246, 238, 0.4); font-size: 12px; }
QCheckBox#settingsCheck { font-size: 13px; color: #e8dcc8; }

QComboBox#themeCombo, QLineEdit#settingLineEdit {
    background: rgba(0, 0, 0, 0.28);
    border: none;
    border-radius: 10px; padding: 10px 12px; color: #faf6ee;
}
QComboBox#themeCombo:hover, QLineEdit#settingLineEdit:focus {
    background: rgba(0, 0, 0, 0.4);
}
QComboBox#themeCombo QAbstractItemView {
    background: #12100a; color: #faf6ee;
    selection-background-color: rgba(255, 170, 0, 0.25);
}

QFrame#featuredPanel {
    background: rgba(16, 12, 6, 0.72);
    border: none;
    border-radius: 14px;
}

QScrollBar:vertical { width: 4px; background: transparent; }
QScrollBar::handle:vertical {
    background: rgba(255, 170, 0, 0.35); min-height: 40px; border-radius: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

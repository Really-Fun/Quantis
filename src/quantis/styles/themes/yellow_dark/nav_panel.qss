QFrame#sideNavRail {
    border-top: 2px solid rgba(255, 170, 0, 0.35);
}

QLabel#navBrandLabel {
    color: #FAF6EE;
    font-size: 14px;
    font-weight: 700;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 8px 10px;
    color: rgba(250, 246, 238, 0.72);
    font-size: 13px;
    font-weight: 600;
    text-align: left;
}

QToolButton#navIconButton:hover {
    background: rgba(255, 170, 0, 0.06);
    color: #FFFFFF;
}

QToolButton#navIconButton:checked {
    background: rgba(255, 170, 0, 0.14);
    color: #FFFFFF;
}

QToolButton#navIconButton:pressed {
    background: rgba(255, 170, 0, 0.2);
}

QToolButton#navPinButton {
    color: rgba(250, 246, 238, 0.7);
}

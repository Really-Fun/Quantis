/* Classic player — сдержанный стальной синий */

#PlayMenu {
    background: rgba(16, 18, 26, 0.94);
    border: none;
    border-radius: 12px;
}

#trackTitle { color: #eef1f5; }
#trackArtist { color: rgba(160, 175, 195, 0.9); }
#timeLabel { color: rgba(160, 175, 195, 0.65); }
#coverLabel { background: rgba(255, 255, 255, 0.05); border: none; }
#volIcon { color: rgba(160, 175, 195, 0.75); }

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.08);
}
#seekSlider::sub-page:horizontal { background: #3aa8d8; border-radius: 2px; }
#seekSlider::handle:horizontal { background: #d8e4ee; }
#seekSlider::handle:horizontal:hover { background: #3aa8d8; }

#volSlider::sub-page:horizontal { background: rgba(58, 168, 216, 0.55); border-radius: 2px; }
#volSlider::handle:horizontal { background: #d8e4ee; }

#controlButton { background: transparent; }
#controlButton:hover { background: rgba(255, 255, 255, 0.06); }
#controlButton[accent=true] {
    background: #2d96c4;
}
#controlButton[accent=true]:hover {
    background: #3aa8d8;
}

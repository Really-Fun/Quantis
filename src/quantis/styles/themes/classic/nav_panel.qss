QFrame#sideNavRail {
    border-top: 2px solid rgba(58, 168, 216, 0.35);
}

QLabel#navBrandLabel {
    color: #E8EEF5;
    font-size: 14px;
    font-weight: 700;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 8px 10px;
    color: rgba(232, 238, 245, 0.72);
    font-size: 13px;
    font-weight: 600;
    text-align: left;
}

QToolButton#navIconButton:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
}

QToolButton#navIconButton:checked {
    background: rgba(58, 168, 216, 0.16);
    color: #FFFFFF;
}

QToolButton#navIconButton:pressed {
    background: rgba(58, 168, 216, 0.24);
}

QToolButton#navPinButton {
    color: rgba(232, 238, 245, 0.7);
}

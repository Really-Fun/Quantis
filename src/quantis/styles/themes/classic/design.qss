/* Classic — тёплый графит, стальной синий, без неона */

QWidget { color: #dde2e8; }

QFrame#glassPanel {
    background: rgba(22, 24, 30, 0.88);
    border: none;
    border-radius: 12px;
}

QFrame#appHeader {
    background: rgba(18, 20, 26, 0.7);
    border: none;
}

#headerGreeting {
    font-size: 20px;
    font-weight: 700;
    color: #eef1f5;
}

#sectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: rgba(140, 165, 190, 0.9);
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

#searchInput {
    background: rgba(0, 0, 0, 0.28);
    border: none;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 14px;
    color: #eef1f5;
}
#searchInput:focus {
    background: rgba(0, 0, 0, 0.42);
}

QPushButton#searchButton {
    background: rgba(45, 150, 196, 0.2);
    border: none;
    border-radius: 10px;
    color: #eef1f5;
    font-weight: 600;
    padding: 8px 16px;
}
QPushButton#searchButton:hover {
    background: rgba(58, 168, 216, 0.25);
}

#searchStatus { color: rgba(160, 175, 195, 0.65); font-size: 11px; }

QLabel#settingsSectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: rgba(140, 165, 190, 0.8);
    letter-spacing: 1.5px;
    text-transform: uppercase;
}
QLabel#settingsRowTitle { color: #eef1f5; font-size: 14px; font-weight: 600; }
QLabel#settingsRowDesc { color: rgba(160, 175, 195, 0.65); font-size: 12px; }
QCheckBox#settingsCheck { font-size: 13px; color: #c8d0da; spacing: 8px; }

QComboBox#themeCombo, QLineEdit#settingLineEdit {
    background: rgba(0, 0, 0, 0.28);
    border: none;
    border-radius: 10px;
    padding: 10px 12px;
    color: #eef1f5;
}
QComboBox#themeCombo:hover, QLineEdit#settingLineEdit:focus {
    background: rgba(0, 0, 0, 0.4);
}
QComboBox#themeCombo QAbstractItemView {
    background: #16181e;
    color: #eef1f5;
    border: none;
    selection-background-color: rgba(58, 168, 216, 0.3);
}

QFrame#featuredPanel {
    background: rgba(20, 22, 28, 0.78);
    border: none;
    border-radius: 12px;
}

QScrollBar:vertical { width: 4px; background: transparent; }
QScrollBar::handle:vertical {
    background: rgba(58, 168, 216, 0.4);
    min-height: 40px;
    border-radius: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

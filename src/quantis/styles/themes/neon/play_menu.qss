/* Aurora player dock — 80px bar aesthetic */

#playerDock {
    background: transparent;
    border: none;
    min-height: 80px;
}

#PlayMenu {
    background: rgba(20, 24, 33, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
}

#trackTitle {
    color: #F2F4F8;
    font-size: 14px;
    font-weight: 650;
}
#trackTitle[playing="true"] { color: #6C5CE7; }
#trackArtist { color: #8A92A6; font-size: 12px; }
#timeLabel { color: #8A92A6; }

#seekSlider::groove:horizontal,
#volSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.08);
    height: 4px;
    border-radius: 2px;
}
#seekSlider::sub-page:horizontal {
    background: #6C5CE7;
    border-radius: 2px;
}
#seekSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #6C5CE7;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
#seekSlider::handle:horizontal:hover {
    background: #6C5CE7;
    border-color: #ffffff;
}

#volSlider::sub-page:horizontal {
    background: rgba(108, 92, 231, 0.55);
    border-radius: 2px;
}
#volSlider::handle:horizontal {
    background: #F2F4F8;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

#controlButton {
    background: transparent;
    color: #F2F4F8;
    border-radius: 20px;
    padding: 0;
    margin: 0;
}
#controlButton:hover {
    background: rgba(255, 255, 255, 0.08);
}
#controlButton[accent=true] {
    background: #6C5CE7;
    border-radius: 20px;
    padding: 0;
    margin: 0;
}
#controlButton[accent=true]:hover {
    background: #7F71F0;
}
#controlButton[liked="true"] {
    background: rgba(255, 78, 69, 0.22);
}
#repeatButton[state="active"] {
    background: rgba(255, 255, 255, 0.08);
}
#repeatButton[repeatMode="track"] {
    background: rgba(108, 92, 231, 0.22);
}
#controlButton[plugin="true"] {
    border: 1px solid rgba(138, 146, 166, 0.35);
}

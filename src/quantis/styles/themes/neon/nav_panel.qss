QFrame#sideNavRail {
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(20, 24, 33, 0.82);
    border-radius: 16px;
}

QFrame#sideNavRail[expanded="true"] {
    background: rgba(20, 24, 33, 0.92);
    border: 1px solid rgba(108, 92, 231, 0.22);
}

QLabel#navBrandLabel {
    color: #F2F4F8;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 10px 12px;
    color: #8A92A6;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
}

QToolButton#navIconButton:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #F2F4F8;
}

QToolButton#navIconButton:checked {
    background: transparent;
    color: #F2F4F8;
}

QToolButton#navIconButton:pressed {
    background: rgba(108, 92, 231, 0.18);
}

QToolButton#navIconButton[plugin="true"] {
    border: 1px solid rgba(138, 146, 166, 0.22);
}

QToolButton#navPinButton {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    color: #8A92A6;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#navPinButton:hover {
    background: rgba(108, 92, 231, 0.16);
    color: #F2F4F8;
}
QToolButton#navPinButton:checked {
    background: rgba(108, 92, 231, 0.28);
    border-color: rgba(108, 92, 231, 0.45);
    color: #F2F4F8;
}

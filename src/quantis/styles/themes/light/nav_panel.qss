QFrame#sideNavRail {
    border: 1px solid rgba(27, 32, 48, 0.08);
    background: rgba(255, 255, 255, 0.82);
    border-radius: 16px;
}

QFrame#sideNavRail[expanded="true"] {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(108, 92, 231, 0.22);
}

QLabel#navBrandLabel {
    color: #1B2030;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QToolButton#navIconButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 10px 12px;
    color: #667085;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
}

QToolButton#navIconButton:hover {
    background: rgba(27, 32, 48, 0.06);
    color: #1B2030;
}

QToolButton#navIconButton:checked {
    background: rgba(108, 92, 231, 0.14);
    color: #1B2030;
}

QToolButton#navIconButton:pressed {
    background: rgba(108, 92, 231, 0.22);
}

QToolButton#navIconButton[plugin="true"] {
    border: 1px solid rgba(102, 112, 133, 0.22);
}

QToolButton#navPinButton {
    background: rgba(27, 32, 48, 0.04);
    border: 1px solid rgba(27, 32, 48, 0.08);
    border-radius: 10px;
    color: #667085;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#navPinButton:hover {
    background: rgba(108, 92, 231, 0.12);
    color: #1B2030;
}
QToolButton#navPinButton:checked {
    background: rgba(108, 92, 231, 0.20);
    border-color: rgba(108, 92, 231, 0.40);
    color: #1B2030;
}
